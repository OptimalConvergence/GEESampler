GEE_PROJECT=your-google-cloud-project
GEE_SERVICE_ACCOUNT=service-account@your-google-cloud-project.iam.gserviceaccount.com
GEE_KEY_FILE=/secure/path/to/service-account-key.json
GEESAMPLER_DATA_ROOT=/path/to/geesampler-data
